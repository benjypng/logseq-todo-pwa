# Logseq graph name (read by the sidecar)
LOGSEQ_GRAPH=my-graph

# Token for the Logseq GUI HTTP API (only used in HTTP backend mode)
VITE_LOGSEQ_TOKEN=your_logseq_api_token

# Comma-separated hostnames Vite should accept (for LAN/VPN access)
# Leave empty if you only access via localhost.
ALLOWED_HOSTS=
